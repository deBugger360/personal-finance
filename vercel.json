{
  "version": 2,
  "name": "personal-finance-pwa",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/handler.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/handler.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
